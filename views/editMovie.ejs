<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Movie</title>
</head>
<body>

    <h1>Edit Movie</h1>

    <form action="/movies/edit/<%= movie.id %>" method="POST">
        <label>Title:</label>
        <input type="text" name="title" value="<%= movie.title %>" required>

        <br><br>

        <label>Director:</label>
        <input type="text" name="director" value="<%= movie.director %>" required>

        <br><br>

        <label>Year:</label>
        <input type="number" name="year" value="<%= movie.release_year %>" required>

        <br><br>

        <label>Genre:</label>
        <input type="text" name="genre" value="<%= movie.genre %>" required>

        <br><br>

        <label>Rating:</label>
        <input
            type="number"
            name="rating"
            min="0"
            max="10"
            step="0.1"
            value="<%= movie.rating !== null ? movie.rating : '' %>"
        >

        <br><br>

        <button type="submit">Save Changes</button>
    </form>

    <br>

    <a href="/">Back to Movie Collection</a>

</body>
</html>