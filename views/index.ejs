<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Collection</title>
</head>
<body>

    <h1>Movie Collection</h1>

    <p>Welcome to my movie collection application.</p>

    <a href="/movies/add">Add New Movie</a>

    <br><br>

<form action="/movies/search" method="GET">
    <input type="text" name="title" placeholder="Search by title">
    <button type="submit">Search</button>
</form>

    <hr>

    <h2>Movies</h2>

    <% if (movies.length === 0) { %>

        <p>No movies in the collection.</p>

    <% } else { %>

        <ul>
            <% movies.forEach(movie => { %>
                <li>
                    <strong><%= movie.title %></strong>
                    - <%= movie.director %>
                    (<%= movie.release_year %>)
                    - <%= movie.genre %>
                    - Rating: <%= movie.rating !== null ? movie.rating : 'Not rated' %>/10

                    <a href="/movies/edit/<%= movie.id %>">Edit</a>

                    <form action="/movies/delete/<%= movie.id %>" method="POST" style="display: inline;">
                        <button type="submit">Delete</button>
                    </form>
                </li>
            <% }); %>
        </ul>

    <% } %>

</body>
</html>